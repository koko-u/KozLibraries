    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>

    <PackageId>kozLibraries.AutoRegisterAnnotation</PackageId>
